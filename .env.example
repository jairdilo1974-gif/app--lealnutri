# Variáveis de Conexão do Neon Auth & Banco de Dados (Projeto Leal NUTRI)
# IMPORTANTE: Nunca insira senhas reais neste arquivo. Copie para .env e preencha localmente.
# Na Vercel, cadastre estas variáveis nas configurações do projeto (Settings -> Environment Variables).

VITE_NEON_AUTH_URL=https://<seu-projeto>.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth
VITE_NEON_DATABASE_URL=postgresql://<usuario>:<senha>@<host>/neondb?sslmode=require
